<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false"/>
    <!-- The recovered service uses HTTP. Limit HTTP to school domains used by the SSO redirects. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">hgnu.edu.cn</domain>
    </domain-config>
</network-security-config>
